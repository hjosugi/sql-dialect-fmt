{
  "name": "snowflake-sql-sql-dialect-fmt",
  "displayName": "Snowflake SQL (sql-dialect-fmt)",
  "description": "Local Snowflake and Databricks SQL formatting, syntax highlighting, and optional LSP diagnostics, hover, and completion.",
  "version": "1.27.0",
  "publisher": "sql-dialect-fmt",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/hjosugi/sql-dialect-fmt.git",
    "directory": "editors"
  },
  "bugs": {
    "url": "https://github.com/hjosugi/sql-dialect-fmt/issues"
  },
  "qna": false,
  "pricing": "Free",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#173d3f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:snowflake-sql",
    "onCommand:sqlDialectFmt.openSettings",
    "onCommand:sqlDialectFmt.restartLanguageServer",
    "onLanguage:sql-postgresql",
    "onLanguage:sql-mysql",
    "onLanguage:sql-mariadb",
    "onLanguage:sql-sqlite",
    "onLanguage:sql-transactsql",
    "onLanguage:sql-bigquery",
    "onLanguage:sql-clickhouse",
    "onLanguage:sql-duckdb",
    "onLanguage:sql-spark",
    "onLanguage:sql-databricks",
    "onLanguage:sql-redshift",
    "onLanguage:sql-trino",
    "onLanguage:sql-hive",
    "onLanguage:sql-db2",
    "onLanguage:sql-db2i",
    "onLanguage:sql-n1ql",
    "onLanguage:sql-plsql",
    "onLanguage:sql-singlestoredb",
    "onLanguage:sql-tidb",
    "onLanguage:sql-standard"
  ],
  "keywords": [
    "snowflake",
    "sql",
    "sql-dialect-fmt",
    "formatter",
    "format on save",
    "databricks",
    "lsp",
    "syntax highlighting",
    "textmate",
    "snowsight",
    "snowflake scripting"
  ],
  "files": [
    "CHANGELOG.md",
    "dist/extension.js",
    "images/icon.png",
    "images/syntax-highlighting.png",
    "LICENSE.md",
    "README.md",
    "language-configuration.json",
    "package.json",
    "snowflake.tmLanguage.json",
    "sql.tmLanguage.json",
    "vendor/sql_dialect_fmt_wasm.wasm"
  ],
  "scripts": {
    "build": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "vscode-languageclient": "^10.1.1",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "contributes": {
    "commands": [
      {
        "command": "sqlDialectFmt.openSettings",
        "title": "sql-dialect-fmt: Open Formatter Settings"
      },
      {
        "command": "sqlDialectFmt.restartLanguageServer",
        "title": "sql-dialect-fmt: Restart Language Server"
      }
    ],
    "configuration": {
      "title": "Snowflake SQL (sql-dialect-fmt)",
      "properties": {
        "sqlDialectFmt.dialect": {
          "type": "string",
          "enum": [
            "snowflake",
            "databricks",
            "spark",
            "bigquery",
            "clickhouse",
            "db2",
            "db2i",
            "duckdb",
            "hive",
            "mariadb",
            "mysql",
            "tidb",
            "n1ql",
            "plsql",
            "postgresql",
            "redshift",
            "singlestoredb",
            "sqlite",
            "sql",
            "transactsql",
            "trino"
          ],
          "default": "snowflake",
          "markdownDescription": "SQL dialect used when formatting `snowflake-sql` documents. Aliases such as `oracle`, `tsql`, `postgres`, and `presto` are accepted."
        },
        "sqlDialectFmt.lineWidth": {
          "type": "integer",
          "default": 80,
          "minimum": 1,
          "description": "Target line width the formatter tries to stay within before wrapping."
        },
        "sqlDialectFmt.indentWidth": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 16,
          "description": "Number of spaces per indentation level."
        },
        "sqlDialectFmt.uppercaseKeywords": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Deprecated compatibility setting. Use `sqlDialectFmt.keywordCase`.",
          "deprecationMessage": "Use sqlDialectFmt.keywordCase instead."
        },
        "sqlDialectFmt.keywordCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "enumDescriptions": [
            "Write recognized SQL keywords in upper case.",
            "Write recognized SQL keywords in lower case.",
            "Keep each recognized keyword's source spelling."
          ],
          "default": "upper",
          "description": "Letter case used for recognized SQL keywords."
        },
        "sqlDialectFmt.selectItemLayout": {
          "type": "string",
          "enum": [
            "vertical",
            "auto"
          ],
          "default": "vertical",
          "markdownDescription": "Use `vertical` for one top-level SELECT item per line, or `auto` to keep short lists inline and wrap at `lineWidth`."
        },
        "sqlDialectFmt.commaStyle": {
          "type": "string",
          "enum": [
            "trailing",
            "leading"
          ],
          "default": "trailing",
          "description": "Place commas after the preceding item or before the following item when a list wraps."
        },
        "sqlDialectFmt.lineEnding": {
          "type": "string",
          "enum": [
            "auto",
            "lf",
            "crlf"
          ],
          "default": "auto",
          "description": "Output line endings. Auto preserves the first line ending found in the document."
        },
        "sqlDialectFmt.dataTypeCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "preserve",
          "description": "Letter case for built-in data-type words in type positions."
        },
        "sqlDialectFmt.functionCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "preserve",
          "description": "Letter case for recognized function names."
        },
        "sqlDialectFmt.identifierCase": {
          "type": "string",
          "enum": [
            "upper",
            "lower",
            "preserve"
          ],
          "default": "preserve",
          "description": "Letter case for unquoted identifiers that are not keywords, types, or function names."
        },
        "sqlDialectFmt.logicalOperatorNewline": {
          "type": "string",
          "enum": [
            "before",
            "after"
          ],
          "default": "before",
          "description": "Where AND/OR sit when a boolean expression wraps across lines."
        },
        "sqlDialectFmt.denseOperators": {
          "type": "boolean",
          "default": false,
          "description": "Pack binary operators without surrounding spaces (price+(price*tax))."
        },
        "sqlDialectFmt.useTabs": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Indent with tab characters instead of spaces. `sqlDialectFmt.indentWidth` still sets one tab's width."
        },
        "sqlDialectFmt.newlineBeforeSemicolon": {
          "type": "boolean",
          "default": false,
          "description": "Place the statement-terminating semicolon on its own line."
        },
        "sqlDialectFmt.linesBetweenQueries": {
          "type": "integer",
          "minimum": 0,
          "markdownDescription": "Force this many blank lines between top-level statements. Leave unset to preserve the author's grouping."
        },
        "sqlDialectFmt.expressionWidth": {
          "type": "integer",
          "minimum": 1,
          "markdownDescription": "Flat width cap for parenthesized lists before they wrap. Leave unset to use `sqlDialectFmt.lineWidth`."
        },
        "sqlDialectFmt.useEditorIndentation": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Use the active editor's `editor.tabSize` for indentation. Disable to use `sqlDialectFmt.indentWidth`."
        },
        "sqlDialectFmt.lsp.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Opt in to the `sql-dialect-fmt-lsp` language server for diagnostics, hover, completion, semantic tokens, document symbols, folding, and on-type formatting (install it with `cargo install sql-dialect-fmt-lsp`). When the server is running it also takes over formatting; when the binary is missing the extension silently falls back to the bundled WebAssembly formatter."
        },
        "sqlDialectFmt.lsp.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `sql-dialect-fmt-lsp` executable. Leave empty to look it up on `PATH`."
        },
        "sqlDialectFmt.lint": {
          "type": "object",
          "default": {},
          "markdownDescription": "Lint diagnostic toggles forwarded to the `sql-dialect-fmt-lsp` language server, e.g. `{ \"enabled\": true, \"selectWildcard\": false, \"largeInListThreshold\": 32 }`. Only used while the LSP client is enabled and running."
        }
      }
    },
